# .env.example
# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Telegram ---
# Get this from @BotFather on Telegram
BOT_TOKEN=

# --- Public URLs ---
# Base URL for interactive tool pages (crop, dashboard) — your toolbox subdomain
PUBLIC_URL=https://toolbox.example.com

# Base URL for /share file links — proxied through Traefik from your main domain
SHARE_BASE=https://example.com/share

# Base URL for /shorten short links — same domain as SHARE_BASE unless you split them later
SHORTEN_BASE=https://example.com/go

# --- Storage ---
# Directory for downloaded/converted files and the SQLite database.
# MUST be a persistent volume in production — losing this loses all stored
# files, share links, short links, and the dashboard.
OUTPUT_DIR=/data/norx-toolbox

# --- Uploads (manual) ---
# Maximum file size (bytes) for manual uploads via the web interface
UPLOAD_MAX_BYTES=2147483648

# Default expiry (seconds) for the automatic "file too big for Telegram" fallback link
LINK_TTL_SECONDS=3600

# --- Web server ---
# Address Hypercorn binds to for the Quart app
WEB_BIND=0.0.0.0:8000